#!/usr/bin/env python3
"""clef-decide: native HTTP helper for Clef (SystemOne) decision gates.

Clef is a DECISION HELPER, not a chat model. It answers structured questions
(choice / noul / score) about a state blob. It does not generate chat
completions and must never be used as the coding agent's primary model.

Four judges can drive the loop, each with a native route (--judge):
  clef       SystemOne, the thorough reader (default)
  clef-flash SystemOne, 9B, fast — high-volume cheap gates
  jev        SystemOne, risk triage and adversarial second opinions
  luna       the /v1/decisions route, structured scored audits (choice only)

--panel fans one choice question out to all four judges in parallel.
Tribunal rule, borrowed from the pgeon tribunal: one judge, one vote;
majority wins; a tie re-runs once, then escalates (exit 2, no auto-pick).

Hard rules (from the integration spec):
- POST only to the Clef endpoint (default
  https://api.experientiallabs.ai/v1/systemone; overridable, see below).
  Luna POSTs only to the decisions endpoint (default
  https://api.experientiallabs.ai/v1/decisions; overridable).
- Bearer key from standard config, in this precedence:
    1. --api-key flag
    2. $CLEF_API_KEY environment variable
    3. $EXPERIENTIAL_API_KEY environment variable (legacy name, still honored)
    4. api_key= in ~/.config/clef-decide/config
  Missing everywhere: stops with setup instructions. The key is never
  requested interactively, never logged. Prefer the env var or config
  file — a CLI flag can appear in shell history and process listings.
- Model sent as "clef", "clef-flash", or "jev-latest" exactly (a ":free"
  suffix spelling is preserved if explicitly selected). Anything else is
  rejected — these are decision helpers, not chat models. Luna's model is
  fixed: gpt-6-luna-decisions.
- No retries, no Idempotency-Key: an unknown outcome may already be charged.
  (The panel's single tie re-run is a new vote, not a retried request.)
- Bounded timeout. HTTP/transport errors surface, nothing is hidden.
- Clef context budget: 16,384 tokens shared by state + question definitions.
  Applied to Luna calls too (conservative; the decisions budget is unpinned).
- Gateway admission bounds: <=32 questions, <=64 options per choice,
  2-10 levels per score.

Usage:
    export CLEF_API_KEY=...
    clef-decide --state-file diff.md --questions questions.json
    clef-decide --state-file diff.md --questions questions.json --judge jev
    clef-decide --state-file report.md --questions done.json --panel
    clef-decide --state-file diff.md --questions questions.json --model clef:free --json

--sot (skeleton-of-judgment): the agent proposes a skeleton of independent
sub-questions (--skeleton-file); each point is judged in its own request, in
parallel; a final gate aggregates the per-point verdicts into the single goal
question (--goal-file). --final-panel sends the goal to the full tribunal.
    clef-decide --sot --state-file report.md --skeleton-file skeleton.json --goal-file goal.json
    clef-decide --sot --state-file report.md --skeleton-file skeleton.json --goal-file goal.json --final-panel

Config file (~/.config/clef-decide/config), KEY=VALUE lines, # comments:
    api_key=...
    endpoint=https://...       (SystemOne route)
    luna_endpoint=https://...  (decisions route)

questions.json shape:
    {
      "review": {"type": "choice", "instructions": "...",
                 "criteria": {"accept": "...", "review": "..."}},
      "urgent": {"type": "noul", "instructions": "Does this ...?"},
      "risk":   {"type": "score", "instructions": "...",
                 "criteria": ["none", "low", "high"]}
    }

Panel mode: questions.json must hold exactly one choice question
(the verdict, e.g. done / not_done).
"""
import json
import os
import sys
import urllib.request
import urllib.error

ENDPOINT = "https://api.experientiallabs.ai/v1/systemone"
LUNA_ENDPOINT = "https://api.experientiallabs.ai/v1/decisions"
LUNA_MODEL = "gpt-6-luna-decisions"
JEV_MODEL = "jev-latest"
KEY_ENV = "CLEF_API_KEY"
LEGACY_KEY_ENV = "EXPERIENTIAL_API_KEY"
ENDPOINT_ENV = "CLEF_ENDPOINT"
LUNA_ENDPOINT_ENV = "LUNA_ENDPOINT"
DEFAULT_CONFIG_PATH = os.path.join(
    os.path.expanduser("~"), ".config", "clef-decide", "config")
DEFAULT_MODEL = "clef"
JUDGES = ("clef", "clef-flash", "jev", "luna")
JUDGE_DEFAULT_MODEL = {"clef": "clef", "clef-flash": "clef-flash", "jev": JEV_MODEL}
ALLOWED_MODELS = ("clef", "clef-flash", "jev-latest")
DEFAULT_TIMEOUT = 60

MAX_CONTEXT_TOKENS = 16384
MAX_QUESTIONS = 32
MAX_CHOICE_OPTIONS = 64
MIN_SCORE_LEVELS = 2
MAX_SCORE_LEVELS = 10


class ClefError(Exception):
    pass


def estimate_tokens(text):
    """Rough token estimate (~4 chars/token). Conservative on purpose."""
    return max(1, len(text) // 4)


def validate_questions(questions):
    if not isinstance(questions, dict) or not questions:
        raise ClefError("questions must be a non-empty map of question ID -> question")
    if len(questions) > MAX_QUESTIONS:
        raise ClefError(f"{len(questions)} questions exceeds gateway bound of {MAX_QUESTIONS}")
    for qid, q in questions.items():
        if not isinstance(q, dict):
            raise ClefError(f"question '{qid}' must be an object")
        qtype = q.get("type")
        if qtype not in ("choice", "noul", "score"):
            raise ClefError(f"question '{qid}': type must be choice|noul|score, got {qtype!r}")
        if not q.get("instructions") or not isinstance(q["instructions"], str):
            raise ClefError(f"question '{qid}': instructions must be a non-empty string")
        criteria = q.get("criteria")
        if qtype == "choice":
            if not isinstance(criteria, dict) or not criteria:
                raise ClefError(f"question '{qid}': choice criteria must map options to descriptions")
            if len(criteria) > MAX_CHOICE_OPTIONS:
                raise ClefError(f"question '{qid}': {len(criteria)} options exceeds bound of {MAX_CHOICE_OPTIONS}")
        elif qtype == "score":
            if not isinstance(criteria, list) or not (MIN_SCORE_LEVELS <= len(criteria) <= MAX_SCORE_LEVELS):
                raise ClefError(
                    f"question '{qid}': score criteria must be an ordered list of "
                    f"{MIN_SCORE_LEVELS}-{MAX_SCORE_LEVELS} level descriptions"
                )
        elif qtype == "noul":
            if criteria is not None and not isinstance(criteria, dict):
                raise ClefError(f"question '{qid}': noul criteria, if given, must map true/false to descriptions")


def check_context_budget(state_text, questions):
    """Refuse to send if state + question definitions exceed Clef's budget."""
    blob = state_text + json.dumps(questions, sort_keys=True)
    est = estimate_tokens(blob)
    if est > MAX_CONTEXT_TOKENS:
        raise ClefError(
            f"estimated {est} tokens exceeds Clef's {MAX_CONTEXT_TOKENS} context budget "
            f"(shared by state + question definitions). Slim the state — send a concise "
            f"diff and test summary, not the whole repository."
        )
    return est


def build_body(model, state, questions):
    return {"model": model, "state": state, "questions": questions}


def read_config_file(path=None):
    """Parse KEY=VALUE lines from the config file. Missing file -> {}."""
    cfg = {}
    p = path or DEFAULT_CONFIG_PATH
    try:
        with open(p, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip().lower()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def resolve_key(flag_value=None, config_path=None):
    """Standard key precedence: flag > $CLEF_API_KEY > $EXPERIENTIAL_API_KEY
    (legacy) > config file. Never prompts, never logs."""
    if flag_value:
        return flag_value
    for env in (KEY_ENV, LEGACY_KEY_ENV):
        v = os.environ.get(env)
        if v:
            return v
    cfg = read_config_file(config_path)
    if cfg.get("api_key"):
        return cfg["api_key"]
    raise ClefError(
        "no API key found. Provide one via --api-key, $CLEF_API_KEY "
        "(legacy: $EXPERIENTIAL_API_KEY), or api_key= in "
        "~/.config/clef-decide/config"
    )


def resolve_endpoint(flag_value=None, config_path=None):
    """Endpoint precedence: flag > $CLEF_ENDPOINT > config file > default."""
    if flag_value:
        ep = flag_value
    elif os.environ.get(ENDPOINT_ENV):
        ep = os.environ[ENDPOINT_ENV]
    else:
        ep = read_config_file(config_path).get("endpoint") or ENDPOINT
    if not ep.startswith("https://"):
        raise ClefError(f"endpoint must be an https:// URL (got {ep!r})")
    return ep


def resolve_luna_endpoint(flag_value=None, config_path=None):
    """Decisions-route precedence: flag > $LUNA_ENDPOINT > config file > default."""
    if flag_value:
        ep = flag_value
    elif os.environ.get(LUNA_ENDPOINT_ENV):
        ep = os.environ[LUNA_ENDPOINT_ENV]
    else:
        ep = read_config_file(config_path).get("luna_endpoint") or LUNA_ENDPOINT
    if not ep.startswith("https://"):
        raise ClefError(f"luna endpoint must be an https:// URL (got {ep!r})")
    return ep


def resolve_judge(judge, model_flag=None):
    """Map --judge to (route, model). route is 'systemone' or 'decisions'.

    --model overrides the SystemOne model string (still allowlisted).
    Luna's model is fixed; --model with --judge luna is rejected.
    """
    if judge not in JUDGES:
        raise ClefError(f"judge must be one of {JUDGES} (got {judge!r})")
    if judge == "luna":
        if model_flag is not None:
            raise ClefError("--model cannot be combined with --judge luna "
                            f"(Luna's model is fixed: {LUNA_MODEL})")
        return ("decisions", LUNA_MODEL)
    model = model_flag or JUDGE_DEFAULT_MODEL[judge]
    base = model.split(":")[0]
    if base not in ALLOWED_MODELS:
        raise ClefError(
            f"model must be one of {ALLOWED_MODELS} (got {model!r}); "
            "these are decision helpers, not chat models")
    return ("systemone", model)


def _post(url, key, body, timeout, _opener=None):
    """Single POST. No retries by design: an unknown outcome may be charged."""
    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
    )
    opener = _opener or urllib.request.urlopen
    try:
        with opener(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:2000]
        raise ClefError(f"HTTP {e.code} from {url}: {detail}")
    except urllib.error.URLError as e:
        raise ClefError(f"transport error calling {url}: {e.reason}")
    except TimeoutError:
        raise ClefError(f"request to {url} timed out after {timeout}s (no retry: outcome unknown)")
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        raise ClefError(f"non-JSON response from {url}: {raw[:500]}")


def call_clef(model, state, questions, timeout=DEFAULT_TIMEOUT,
              api_key=None, endpoint=None, config_path=None, _opener=None):
    """POST to the SystemOne endpoint. No retries. Surfaces all errors."""
    key = resolve_key(api_key, config_path)
    url = resolve_endpoint(endpoint, config_path)
    base = model.split(":")[0]
    if base not in ALLOWED_MODELS:
        raise ClefError(
            f"model must be one of {ALLOWED_MODELS} (got {model!r}); "
            "these are decision helpers, not chat models")
    validate_questions(questions)
    state_text = state if isinstance(state, str) else json.dumps(state, sort_keys=True)
    est = check_context_budget(state_text, questions)
    payload = _post(url, key, build_body(model, state, questions), timeout, _opener)
    return payload, est


def call_luna(state, questions, timeout=DEFAULT_TIMEOUT,
              api_key=None, luna_endpoint=None, config_path=None, _opener=None):
    """POST to the decisions endpoint (Luna's native route). Choice only.

    The decisions shape is proven, not guessed: model, input, and a list of
    choice questions with value/description options. noul/score are rejected
    with a pointer to the SystemOne judges. Response is normalized to the
    SystemOne answers shape so render_human works unchanged.
    """
    key = resolve_key(api_key, config_path)
    url = resolve_luna_endpoint(luna_endpoint, config_path)
    validate_questions(questions)
    for qid, q in questions.items():
        if q.get("type") != "choice":
            raise ClefError(
                f"question '{qid}': the Luna decisions route supports choice "
                "questions only; use a SystemOne judge (clef, clef-flash, jev) "
                f"for {q.get('type')}")
    state_text = state if isinstance(state, str) else json.dumps(state, sort_keys=True)
    est = check_context_budget(state_text, questions)
    body = {
        "model": LUNA_MODEL,
        "input": state,
        "questions": [
            {"type": "choice", "name": qid, "instructions": q["instructions"],
             "choices": [{"value": k, "description": v}
                         for k, v in q["criteria"].items()]}
            for qid, q in questions.items()
        ],
    }
    payload = _post(url, key, body, timeout, _opener)
    raw_answers = payload.get("answers", [])
    if len(raw_answers) != len(questions):
        raise ClefError(
            f"Luna decisions route returned {len(raw_answers)} answers for "
            f"{len(questions)} questions; refusing to guess the mapping")
    answers = {}
    for qid, ans in zip(questions.keys(), raw_answers):
        answers[qid] = {
            "type": "choice",
            "choice": ans.get("choice"),
            "confidence": ans.get("confidence"),
            "probabilities": _probs_dict(ans.get("probabilities", {})),
        }
    payload["answers"] = answers
    return payload, est


def _probs_dict(probs):
    """Normalize probabilities to {option: float}, list or dict form."""
    if isinstance(probs, list):
        return {p["value"]: p["probability"] for p in probs}
    return dict(probs)


def call_judge(judge, state, questions, timeout=DEFAULT_TIMEOUT,
               api_key=None, endpoint=None, luna_endpoint=None,
               config_path=None, model=None, _opener=None):
    """Dispatch to the judge's native route. Returns (payload, est)."""
    route, resolved_model = resolve_judge(judge, model)
    if route == "decisions":
        return call_luna(state, questions, timeout, api_key, luna_endpoint,
                         config_path, _opener)
    return call_clef(resolved_model, state, questions, timeout, api_key,
                     endpoint, config_path, _opener)


def _judge_vote(judge, state_text, qid, question, timeout, api_key,
                endpoint, luna_endpoint, config_path, _opener):
    """One judge, one vote: weigh natively, return (choice, probs dict)."""
    payload, _ = call_judge(judge, state_text, {qid: question}, timeout,
                            api_key, endpoint, luna_endpoint, config_path,
                            _opener=_opener)
    ans = payload["answers"][qid]
    return ans.get("choice"), _probs_dict(ans.get("probabilities", {}))


def panel_vote(state, questions, timeout=DEFAULT_TIMEOUT, api_key=None,
               endpoint=None, luna_endpoint=None, config_path=None,
               _opener=None, _judge_fn=None):
    """Tribunal vote over exactly one choice question.

    Every judge weighs the question on its native route and casts one vote.
    Majority wins. A tie re-runs once (new votes, not retried requests);
    a second tie escalates: winner is None and the caller must not auto-pick.
    Returns a dict with qid, options, rounds, votes, counts, winner, tie,
    and mean_probabilities.
    """
    if not isinstance(questions, dict) or len(questions) != 1:
        raise ClefError("--panel needs exactly one question in the questions file")
    qid, question = next(iter(questions.items()))
    if question.get("type") != "choice":
        raise ClefError("--panel needs a choice question "
                        f"(got {question.get('type')!r} for '{qid}')")
    validate_questions(questions)
    state_text = state if isinstance(state, str) else json.dumps(state, sort_keys=True)
    check_context_budget(state_text, questions)
    options = list(question["criteria"].keys())

    vote_fn = _judge_fn or (lambda j: _judge_vote(
        j, state_text, qid, question, timeout, api_key,
        endpoint, luna_endpoint, config_path, _opener))

    def attributed(judge):
        try:
            return vote_fn(judge)
        except ClefError as e:
            raise ClefError(f"[{judge}] {e}")
        except Exception as e:  # noqa: BLE001 — attribute, don't swallow
            raise ClefError(f"[{judge}] unexpected error: {e}")

    import concurrent.futures as cf
    rounds = []
    for _ in range(2):
        votes, probs = {}, {}
        with cf.ThreadPoolExecutor(max_workers=len(JUDGES)) as ex:
            futs = {ex.submit(attributed, j): j for j in JUDGES}
            for f in cf.as_completed(futs):
                j = futs[f]
                choice, p = f.result()
                votes[j] = choice
                probs[j] = p
        counts = {}
        for c in votes.values():
            counts[c] = counts.get(c, 0) + 1
        rounds.append({"votes": votes, "counts": counts})
        top = max(counts.values())
        leaders = [c for c, n in counts.items() if n == top]
        if len(leaders) == 1:
            break

    final = rounds[-1]
    top = max(final["counts"].values())
    leaders = [c for c, n in final["counts"].items() if n == top]
    mean = {}
    for opt in options:
        vals = [probs.get(j, {}).get(opt, 0.0) for j in JUDGES]
        mean[opt] = round(sum(vals) / len(vals), 3)
    return {
        "qid": qid,
        "options": options,
        "rounds": rounds,
        "winner": leaders[0] if len(leaders) == 1 else None,
        "tie": len(leaders) > 1,
        "mean_probabilities": mean,
    }


def render_panel(result):
    """Human-readable tribunal report."""
    lines = [f"[panel:{result['qid']}]"]
    for i, rnd in enumerate(result["rounds"], 1):
        v = ", ".join(f"{j}={c}" for j, c in sorted(rnd["votes"].items()))
        lines.append(f"  round {i}: {v}")
    if result["tie"]:
        lines.append("  TIE after 2 rounds — escalate to the owner, do not auto-pick.")
    else:
        lines.append(f"  winner: {result['winner']}")
    mp = ", ".join(f"{k}={v}" for k, v in result["mean_probabilities"].items())
    lines.append(f"  mean probabilities: {mp}")
    lines.append("note: probabilities/confidence are not guarantees of correctness.")
    return "\n".join(lines)


def _skeleton_verdict_line(qid, ans):
    """One compact line summarizing a skeleton point's answer."""
    atype = ans.get("type", "?")
    if atype == "choice":
        return f"{qid} -> {ans.get('choice')} (confidence {ans.get('confidence')})"
    if atype == "score":
        return f"{qid} -> {ans.get('score')} (confidence {ans.get('confidence')})"
    if atype == "noul":
        return f"{qid} -> {ans.get('noul')}"
    return f"{qid} -> {json.dumps(ans)}"


def sot_judge(state, skeleton, goal, judge="clef", timeout=DEFAULT_TIMEOUT,
              api_key=None, endpoint=None, luna_endpoint=None,
              config_path=None, model=None, final_panel=False,
              _opener=None):
    """Skeleton-of-judgment: decompose, expand in parallel, aggregate.

    The skeleton is a map of independent sub-questions proposed by the
    agent (the panel judges; it does not invent structure). Each point gets
    its own request, so each point sees the full state under its own
    context budget, and all points evaluate in parallel. The aggregation
    gate then asks the single goal question against the original state plus
    the per-point verdicts. With final_panel=True the goal goes to the full
    tribunal (one judge, one vote) instead of the single judge.

    Hard rules hold throughout: no retries, 16k token budget per request,
    one key, errors name the failing skeleton point.
    """
    validate_questions(skeleton)
    validate_questions(goal)
    if len(goal) != 1:
        raise ClefError(f"the goal file must hold exactly one question (got {len(goal)})")
    gid = next(iter(goal))
    if gid in skeleton:
        raise ClefError(f"goal question id '{gid}' collides with a skeleton point id")
    state_text = state if isinstance(state, str) else json.dumps(state, sort_keys=True)

    import concurrent.futures as cf

    def attributed(qid, question):
        try:
            payload, _ = call_judge(judge, state_text, {qid: question},
                                    timeout, api_key, endpoint, luna_endpoint,
                                    config_path, model, _opener)
            return payload["answers"][qid]
        except ClefError as e:
            raise ClefError(f"[skeleton:{qid}] {e}")
        except Exception as e:  # noqa: BLE001 - attribute, don't swallow
            raise ClefError(f"[skeleton:{qid}] unexpected error: {e}")

    answers = {}
    with cf.ThreadPoolExecutor(max_workers=len(skeleton)) as ex:
        futs = {ex.submit(attributed, qid, q): qid for qid, q in skeleton.items()}
        for f in cf.as_completed(futs):
            answers[futs[f]] = f.result()

    order = list(skeleton.keys())
    lines = [_skeleton_verdict_line(qid, answers[qid]) for qid in order]
    agg_state = (state_text + "\n\nSkeleton point verdicts (each judged independently):\n"
                 + "\n".join(lines))
    check_context_budget(agg_state, goal)

    if final_panel:
        result = panel_vote(agg_state, goal, timeout, api_key, endpoint,
                            luna_endpoint, config_path, _opener)
        return {"skeleton_ids": order, "skeleton": answers,
                "final": result, "final_panel": True}
    payload, _est = call_judge(judge, agg_state, goal, timeout, api_key,
                               endpoint, luna_endpoint, config_path, model,
                               _opener)
    return {"skeleton_ids": order, "skeleton": answers,
            "final": payload, "final_panel": False}


def render_sot(result):
    """Human-readable skeleton-of-judgment report."""
    lines = [f"[sot:skeleton] {len(result['skeleton_ids'])} points, each judged in its own request"]
    for qid in result["skeleton_ids"]:
        lines.append(f"  {_skeleton_verdict_line(qid, result['skeleton'][qid])}")
    lines.append("[sot:final]")
    if result["final_panel"]:
        for rl in render_panel(result["final"]).splitlines():
            lines.append(f"  {rl}")
    else:
        for qid, ans in result["final"].get("answers", {}).items():
            lines.append(f"  {_skeleton_verdict_line(qid, ans)}")
    usage = result["final"].get("usage", {}) if not result["final_panel"] else {}
    if usage:
        lines.append(f"  usage: input_tokens={usage.get('input_tokens')} output_tokens={usage.get('output_tokens')}")
    lines.append("note: probabilities/confidence are not guarantees of correctness.")
    return "\n".join(lines)


def render_human(payload):
    """Decision + reported usage, by question ID. Confidence is not correctness."""
    lines = []
    answers = payload.get("answers", {})
    for qid, ans in answers.items():
        atype = ans.get("type", "?")
        if atype == "choice":
            lines.append(f"[{qid}] choice -> {ans.get('choice')} (confidence {ans.get('confidence')})")
        elif atype == "score":
            lines.append(f"[{qid}] score -> {ans.get('score')} (confidence {ans.get('confidence')})")
        elif atype == "noul":
            lines.append(f"[{qid}] noul -> {ans.get('noul')}")
        else:
            lines.append(f"[{qid}] ({atype}): {json.dumps(ans)}")
    usage = payload.get("usage", {})
    lines.append(f"usage: input_tokens={usage.get('input_tokens')} output_tokens={usage.get('output_tokens')}")
    lines.append("note: probabilities/confidence are not guarantees of correctness.")
    return "\n".join(lines)


def main(argv):
    import argparse
    ap = argparse.ArgumentParser(description="Clef decision helper (SystemOne). Never a chat model.")
    ap.add_argument("--state-file", required=True, help="file with the state text (concise diff + test summary)")
    ap.add_argument("--questions", default=None, help="JSON file: map of question ID -> question")
    ap.add_argument("--sot", action="store_true",
                    help="skeleton-of-judgment: judge each skeleton point in its own "
                         "request, then aggregate into the goal question")
    ap.add_argument("--skeleton-file", default=None,
                    help="JSON file: map of point ID -> question (required with --sot)")
    ap.add_argument("--goal-file", default=None,
                    help="JSON file: exactly one question, the final verdict (required with --sot)")
    ap.add_argument("--final-panel", action="store_true",
                    help="with --sot: send the goal to the full tribunal instead of the single judge")
    ap.add_argument("--judge", default=None, choices=JUDGES,
                    help="which judge drives (default: clef; luna uses the decisions route, choice only)")
    ap.add_argument("--panel", action="store_true",
                    help="tribunal vote: all four judges vote on one choice question, majority wins")
    ap.add_argument("--model", default=None,
                    help="SystemOne model override (clef, clef-flash, jev-latest; :free preserved). Not for luna.")
    ap.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT, help="bounded seconds (no retries)")
    ap.add_argument("--api-key", default=None,
                    help="Bearer key (highest precedence; prefer $CLEF_API_KEY or the config file — flags can leak into shell history)")
    ap.add_argument("--endpoint", default=None,
                    help=f"SystemOne endpoint URL (default {ENDPOINT})")
    ap.add_argument("--luna-endpoint", default=None,
                    help=f"decisions endpoint URL for Luna (default {LUNA_ENDPOINT})")
    ap.add_argument("--json", action="store_true", help="print raw response JSON instead of human summary")
    args = ap.parse_args(argv)

    try:
        with open(args.state_file, "r", encoding="utf-8") as f:
            state = f.read()
        if args.sot:
            if args.questions is not None:
                raise ClefError("--sot uses --skeleton-file and --goal-file, not --questions")
            if args.panel:
                raise ClefError("--sot cannot be combined with --panel; "
                                "add --final-panel for a tribunal verdict")
            if not args.skeleton_file or not args.goal_file:
                raise ClefError("--sot needs --skeleton-file and --goal-file")
            with open(args.skeleton_file, "r", encoding="utf-8") as f:
                skeleton = json.load(f)
            with open(args.goal_file, "r", encoding="utf-8") as f:
                goal = json.load(f)
            result = sot_judge(state, skeleton, goal, judge=args.judge or "clef",
                               timeout=args.timeout, api_key=args.api_key,
                               endpoint=args.endpoint,
                               luna_endpoint=args.luna_endpoint,
                               model=args.model, final_panel=args.final_panel)
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                print(render_sot(result))
            if result["final_panel"]:
                return 0 if result["final"]["winner"] else 2
            return 0
        if args.questions is None:
            raise ClefError("--questions is required "
                            "(or --sot with --skeleton-file/--goal-file)")
        with open(args.questions, "r", encoding="utf-8") as f:
            questions = json.load(f)
        if args.panel:
            if args.judge is not None or args.model is not None:
                raise ClefError("--panel uses all four judges; it cannot be "
                                "combined with --judge or --model")
            result = panel_vote(state, questions, timeout=args.timeout,
                                api_key=args.api_key, endpoint=args.endpoint,
                                luna_endpoint=args.luna_endpoint)
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                print(render_panel(result))
            return 0 if result["winner"] else 2
        payload, _est = call_judge(args.judge or "clef", state, questions,
                                   timeout=args.timeout,
                                   api_key=args.api_key,
                                   endpoint=args.endpoint,
                                   luna_endpoint=args.luna_endpoint,
                                   model=args.model)
    except ClefError as e:
        print(f"clef-decide: {e}", file=sys.stderr)
        return 2
    except OSError as e:
        print(f"clef-decide: file error: {e}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(render_human(payload))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
