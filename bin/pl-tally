#!/usr/bin/env python3
"""pl-tally: apply the tribunal rule to vote results.

stdin   result JSONL from pl-ask — one choice answer per judge for one
        question (as produced by pl-split --per-judge | pl-ask)
stdout  one JSON line: {"qid", "votes": {judge: choice}, "counts",
        "winner", "tie", "mean_probabilities"}

One judge, one vote; majority wins (same function as clef-decide --panel).
Exit 0 with a winner, exit 2 on a tie. The panel rule is "a tie re-runs once,
a second tie escalates": re-run the fan-out with --round 2 (a new vote, so a
new cache key), and if pl-tally exits 2 again, escalate to the owner.
Exit 65 if any result failed, a judge voted twice, or results mix questions.
"""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pl_common import core, parser, read_jsonl, run, write_jsonl  # noqa: E402

STAGE = "pl-tally"


def tally_records(records):
    votes, probs, qid = {}, {}, None
    for rec in records:
        if not rec.get("ok"):
            raise core.ClefError(f"vote from {rec.get('judge')} failed; refusing to tally a partial panel",
                                 judge=rec.get("judge"), fix="see the pl-ask error above and re-run")
        answers = rec.get("answers", {})
        if len(answers) != 1:
            raise core.ClefError("each vote must answer exactly one question")
        q, ans = next(iter(answers.items()))
        if qid is not None and q != qid:
            raise core.ClefError(f"results mix questions ({qid!r} and {q!r})")
        qid = q
        j = rec.get("judge")
        if j in votes:
            raise core.ClefError(f"judge {j!r} voted twice; one judge, one vote", judge=j)
        votes[j] = ans.get("choice")
        probs[j] = core._probs_dict(ans.get("probabilities", {}))
    if not votes:
        raise core.ClefError("no votes on stdin", fix="pipe pl-ask output into pl-tally")
    counts, leaders = core.tally(votes)
    options = sorted({o for p in probs.values() for o in p})
    mean = {o: round(sum(probs[j].get(o, 0.0) for j in votes) / len(votes), 3) for o in options}
    return {"qid": qid, "votes": votes, "counts": counts,
            "winner": leaders[0] if len(leaders) == 1 else None,
            "tie": len(leaders) > 1, "mean_probabilities": mean}


def main(argv, stdin=None):
    ap = parser(STAGE, "Majority vote over pl-ask results.")
    args = ap.parse_args(argv)
    if args.verbose:
        os.environ[core.DEBUG_ENV] = "1"
    res = tally_records(obj for _, obj in read_jsonl(stdin or sys.stdin, STAGE))
    write_jsonl(res)
    if res["tie"]:
        print(f"{STAGE}: TIE on {res['qid']} — re-run once with --round 2; "
              "a second tie escalates to the owner, never auto-pick", file=sys.stderr)
        return core.EXIT_TIE
    return core.EXIT_OK


if __name__ == "__main__":
    sys.exit(run(STAGE, main, sys.argv[1:]))
