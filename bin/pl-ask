#!/usr/bin/env python3
"""pl-ask: send request JSONL to the judges; write result JSONL.

stdin   request lines from pl-split / pl-aggregate (or your own):
        {"id", "judge", "model"?, "round"?, "state", "questions"}
stdout  one result line per request, in input order:
        {"id", "judge", "model", "round", "key", "ok": true,
         "answers": {...}, "usage": {...}, "cached": false}
        or {"id", ..., "ok": false, "error": {stage, judge, model, status,
            endpoint, cause, fix, exit}}
stderr  structured errors (human line + JSON line per failure); --verbose debug

--jobs N     parallel requests (default 1). Results still print in input order.
--shard I/N  only handle lines where (index % N) == I, for splitting work
             across processes or machines (e.g. xargs -P / GNU parallel).
--state-dir  resumable cache: each successful result is written atomically to
             <dir>/<key>.json (key = sha256 of judge, model, round, state,
             questions). A re-run skips cached keys, so re-running after a
             crash never re-sends a request that already succeeded. Failures
             are not cached. Also $PANEL_LOOP_STATE_DIR.

No automatic retries (the core rule: an unknown outcome may already be
charged). Exit 0 if every request succeeded, else the exit code of the first
failed request in input order.
"""
import concurrent.futures as cf
import hashlib
import json
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pl_common import core, parser, read_jsonl, run, write_jsonl  # noqa: E402

STAGE = "pl-ask"
STATE_DIR_ENV = "PANEL_LOOP_STATE_DIR"


def request_key(req):
    blob = json.dumps({k: req.get(k) for k in ("judge", "model", "round", "state", "questions")},
                      sort_keys=True)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def parse_shard(s):
    try:
        i, n = (int(x) for x in s.split("/"))
        if n < 1 or not 0 <= i < n:
            raise ValueError
        return i, n
    except ValueError:
        raise core.ClefError(f"--shard must be I/N with 0 <= I < N (got {s!r})",
                             code=core.EXIT_USAGE)


def ask_one(req, args, _call=None):
    """One request -> one result record. Never raises ClefError."""
    call = _call or core.call_judge
    base = {"id": req.get("id"), "judge": req.get("judge") or "clef",
            "model": req.get("model"), "round": req.get("round", 1), "key": request_key(req)}
    try:
        for f in ("id", "state", "questions"):
            if f not in req:
                raise core.ClefError(f"request is missing '{f}'", code=core.EXIT_DATA,
                                     fix="requests need id, state, questions (see pl-split)")
        payload, _ = call(base["judge"], req["state"], req["questions"],
                          timeout=args.timeout, endpoint=args.endpoint,
                          luna_endpoint=args.luna_endpoint, config_path=args.config,
                          model=base["model"])
        return dict(base, ok=True, answers=payload.get("answers", {}),
                    usage=payload.get("usage", {}), cached=False)
    except core.ClefError as e:
        e = e.prefixed(f"[{base['id']}:{base['judge']}] ", stage=STAGE, judge=base["judge"])
        return dict(base, ok=False, error=e.to_dict())
    except Exception as e:  # noqa: BLE001 — attribute, don't swallow
        err = core.ClefError(f"[{base['id']}:{base['judge']}] unexpected error: {e}",
                             code=core.EXIT_INTERNAL, stage=STAGE, judge=base["judge"])
        return dict(base, ok=False, error=err.to_dict())


def cache_get(state_dir, key):
    if not state_dir:
        return None
    try:
        with open(os.path.join(state_dir, key + ".json"), "r", encoding="utf-8") as f:
            rec = json.load(f)
        rec["cached"] = True
        return rec
    except (OSError, json.JSONDecodeError):
        return None


def cache_put(state_dir, rec):
    if not state_dir or not rec.get("ok"):
        return
    path = os.path.join(state_dir, rec["key"] + ".json")
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(rec, f, sort_keys=True)
    os.replace(tmp, path)  # atomic: a crash never leaves a half-written result


def process(reqs, args, _call=None, out=None):
    """Run requests (list), emit results in input order; return exit code."""
    state_dir = args.state_dir
    if state_dir:
        os.makedirs(state_dir, exist_ok=True)
    results = [None] * len(reqs)
    todo = []
    for i, r in enumerate(reqs):
        hit = cache_get(state_dir, request_key(r))
        if hit:
            core.debug(f"cache hit {hit['key'][:12]} id={hit['id']}")
            results[i] = hit
        else:
            todo.append(i)
    with cf.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as ex:
        futs = {ex.submit(ask_one, reqs[i], args, _call): i for i in todo}
        for f in cf.as_completed(futs):
            rec = f.result()
            cache_put(state_dir, rec)
            results[futs[f]] = rec
    code = core.EXIT_OK
    for rec in results:
        write_jsonl(rec, out)
        if not rec["ok"]:
            err = rec["error"]
            print(f"{STAGE}: {err['error']}", file=sys.stderr)
            if err.get("fix"):
                print(f"{STAGE}: fix: {err['fix']}", file=sys.stderr)
            print(json.dumps(err, sort_keys=True), file=sys.stderr)
            if code == core.EXIT_OK:
                code = err["exit"]
    return code


def build_parser():
    ap = parser(STAGE, "Send request JSONL to the judges; emit result JSONL.")
    ap.add_argument("--jobs", "-P", type=int, default=1, help="parallel requests (default 1)")
    ap.add_argument("--shard", default=None, help="I/N: handle only every Nth line starting at I")
    ap.add_argument("--state-dir", default=os.environ.get(STATE_DIR_ENV),
                    help=f"resumable result cache dir (or ${STATE_DIR_ENV})")
    ap.add_argument("--timeout", type=int, default=core.DEFAULT_TIMEOUT)
    ap.add_argument("--endpoint", default=None)
    ap.add_argument("--luna-endpoint", default=None)
    ap.add_argument("--config", default=None, help="config file (default ~/.config/clef-decide/config)")
    return ap


def main(argv, stdin=None, _call=None, out=None):
    args = build_parser().parse_args(argv)
    if args.verbose:
        os.environ[core.DEBUG_ENV] = "1"
    reqs = [obj for _, obj in read_jsonl(stdin or sys.stdin, STAGE)]
    if args.shard:
        i, n = parse_shard(args.shard)
        reqs = [r for k, r in enumerate(reqs) if k % n == i]
    core.debug(f"{len(reqs)} requests, jobs={args.jobs}, state_dir={args.state_dir}")
    return process(reqs, args, _call, out)


if __name__ == "__main__":
    sys.exit(run(STAGE, main, sys.argv[1:]))
